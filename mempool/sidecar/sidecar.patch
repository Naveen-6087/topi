diff --git a/packages/executor/src/services/AdmissionPolicy/index.ts b/packages/executor/src/services/AdmissionPolicy/index.ts
new file mode 100644
index 0000000..3151f6f
--- /dev/null
+++ b/packages/executor/src/services/AdmissionPolicy/index.ts
@@ -0,0 +1,42 @@
+/**
+ * An alternative mempool's own admission rules (ERC-8421: "a mempool is defined by its rules"),
+ * loaded from an ES module so a mempool can be defined without forking this validator.
+ *
+ * The module's default export receives `{ rpcEndpoint, chainId, log }` and returns (or resolves to)
+ * an `AdmissionPolicy`. `check` runs after the sidecar's own structural, signature and simulation
+ * checks, at admission and on every re-simulation (`MempoolReconciler`, once per block), and throws
+ * with the rule's reason to refuse; the refusal is reported under the explorer's `policy` rule.
+ */
+import { pathToFileURL } from "node:url";
+import { Hex } from "viem";
+import { FrameTransaction } from "@skandha/types/lib/contracts/FrameTx.js";
+
+export interface AdmissionPolicy {
+  /** Short name for logs and the explorer. */
+  name: string;
+  /** Throws (with the broken rule as message) to refuse `tx`. */
+  check(tx: FrameTransaction, rawTx: Hex): Promise<void>;
+}
+
+export interface AdmissionPolicyContext {
+  rpcEndpoint: string;
+  chainId: number;
+  log: (line: string) => void;
+}
+
+export async function loadAdmissionPolicy(
+  path: string,
+  context: AdmissionPolicyContext
+): Promise<AdmissionPolicy> {
+  const url = /^[a-z]+:/i.test(path) && !/^[a-z]:[\/]/i.test(path) ? path : pathToFileURL(path).href;
+  const mod = await import(url);
+  const build = mod.default ?? mod.createPolicy;
+  if (typeof build !== "function") {
+    throw new Error(`admission policy ${path} has no default export`);
+  }
+  const policy = (await build(context)) as AdmissionPolicy;
+  if (!policy || typeof policy.check !== "function") {
+    throw new Error(`admission policy ${path} did not return { name, check }`);
+  }
+  return policy;
+}
