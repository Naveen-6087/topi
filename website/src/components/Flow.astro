---
/** The mixnet in one picture: traceable packets go in, identical packets come out, in a new order. */
import PixelText from "./PixelText.astro";
---

<section id="mixnet" class="night flow" aria-labelledby="flow-title">
  <div class="wrap head">
    <PixelText id="flow-title" text="Every packet l{o}oks the same." />
    <p class="lead">Three hops, shuffled batches, cover traffic. What leaves cannot be matched to what went in.</p>
  </div>
  <figure class="field" data-flow>
    <canvas aria-hidden="true"></canvas>
    <figcaption class="visually-hidden">
      Packets of many colours enter a box of three hops and leave identical, in shuffled order.
    </figcaption>
    <p class="tag" aria-hidden="true">Mixnet</p>
  </figure>
</section>

<script>
  import { mountFlow } from "../scripts/flow";
  const field = document.querySelector<HTMLElement>("[data-flow]");
  if (field) mountFlow(field);
</script>

<style>
  .flow {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
  }
  .head {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }
  .head :global(h2) {
    font-size: clamp(2.4rem, 5.5vw, 4.6rem);
  }
  .head .lead {
    max-width: 40ch;
  }
  .field {
    position: relative;
    margin: clamp(1rem, 3vw, 2rem) 0 0;
    height: clamp(300px, 46vh, 480px);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .tag {
    position: absolute;
    left: 50%;
    top: calc(var(--box-top, 30%) - 2.4rem);
    transform: translateX(-50%);
    font-family: var(--code);
    font-size: 0.75rem;
    color: var(--fg);
    pointer-events: none;
  }
</style>
