# Copy to .env and adjust. Every script reads it; nothing here is required on a standard setup.

# Chain
RPC_URL=https://rpc1.privacy.ethrex.xyz
# Submit settles through the alternative mempool (mempool/) instead of straight to RPC_URL
# MEMPOOL_URL=http://127.0.0.1:47500/rpc
# MEMPOOL_PEERS=http://10.0.0.2:47500
# MEMPOOL_PAYMASTERS=0x...
# Deployment records the scripts use by default
POOL_DEPLOYMENT=deployments/8141/pool.json
ACCOUNT_DEPLOYMENT=deployments/8141/account.json

# Keys (paths). The deployer is an ECDSA key file; the PQ keys are leanSPHINCS key files from `lsk`.
DEPLOYER_KEY=.secrets/deployer.key
# ECDSA operator key for a classic (ECDSA) paymaster; defaults to DEPLOYER_KEY
# OPERATOR_KEY=.secrets/deployer.key
EXIT_PQ_KEY=.secrets/pq/exit.key
ACCOUNT_PQ_KEY=.secrets/pq/user.key
MEMBER_IDENTITY=.secrets/member.id
MEMBERS_FILE=data/members.txt

# leanSPHINCS signer binary (github.com/nconsigny/SPHINCS-, signers/leansphincs-keccak)
LSK_BIN=lsk

# Binaries the scripts run (defaults: the repository's build outputs; .exe is added on Windows)
# MIXNET_CLIENT=target/release/topi-client
# LEAN_POLICY_BIN=lean/.lake/build/bin/pool-policy
# Optional tool locations for scripts/deploy.sh (otherwise forge, cast and node come from PATH)
# FOUNDRY_BIN=
# NODE_BIN=

# Prover workspace (Linux or WSL path); prover/setup.sh clones and builds the upstream provers here
PROVER_HOME=$HOME/.local/share/pq-prover
# On Windows the prover runs in this WSL distribution
WSL_DISTRO=Ubuntu

# AWS deployment
DEPLOYMENT_NAME=topi
OPERATOR_CIDR=0.0.0.0/0
LINUX_TARGET_DIR=target/linux
