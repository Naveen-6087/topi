    /// spartan-whir withdrawal::hash_fields: state[16]=domain, [17]=len, [18]=1; add 16-element blocks
    /// into state[0..16] and permute after each; an empty input still permutes once; output state[0..8].
    function hashFields(uint256 domain, uint256[] memory input) internal pure returns (uint256[8] memory out) {
        uint256[24] memory s;
        s[16] = domain;
        s[17] = input.length;
        s[18] = 1;
        for (uint256 off = 0; off < input.length; off += 16) {
            for (uint256 i = 0; i < 16 && off + i < input.length; ++i) {
                uint256 v = input[off + i];
                if (v >= P) revert NonCanonicalField();
                s[i] = addmod(s[i], v, P);
            }
            permute(s);
        }
        if (input.length == 0) permute(s);
        for (uint256 i = 0; i < 8; ++i) out[i] = s[i];
    }

    /// One withdrawal-tree node: hash_fields(POOL_NODE = 4, left || right).
    function node(uint256[8] memory left, uint256[8] memory right) internal pure returns (uint256[8] memory out) {
        return nodeIn(4, left, right);
    }

    /// One tree node under a domain: 4 = pool tree, 5 = association tree (spartan-whir withdrawal.rs).
    function nodeIn(uint256 domain, uint256[8] memory left, uint256[8] memory right)
        internal
        pure
        returns (uint256[8] memory out)
    {
        uint256[24] memory s;
        for (uint256 i = 0; i < 8; ++i) {
            if (left[i] >= P || right[i] >= P) revert NonCanonicalField();
            s[i] = left[i];
            s[i + 8] = right[i];
        }
        s[16] = domain;
        s[17] = 16;
        s[18] = 1;
        permute(s);
        for (uint256 i = 0; i < 8; ++i) out[i] = s[i];
    }
