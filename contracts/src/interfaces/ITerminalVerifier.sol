pragma solidity ^0.8.28;

/// @title ITerminalVerifier
/// @notice The leanVM grouped terminal verifier generated by ethereum/sol-whir-p3
/// (src/verifier/LeanVmGroupedTerminal_KeccakPow28T6Lean.sol). Selector 0x5801ce09.
/// @dev ShieldedPool forwards the caller's calldata verbatim and then reads `applicationRoot` at calldata
/// offset 100 (selector, tuple offset, transcript and openings offsets), so the struct layout is part
/// of the pool's interface.
interface ITerminalVerifier {
    struct Proof {
        bytes transcript;
        bytes openings;
        uint256[8] applicationRoot;
        uint256[] sparkPoint;
        uint256 sparkValue;
        uint256[] liftPoint;
        uint256 liftValue;
        uint256 rootValue;
    }

    /// @notice Returns true iff `proof` is a valid terminal proof for `proof.applicationRoot`.
    function verifyGroupedLogupV1(Proof calldata proof) external view returns (bool);
}
